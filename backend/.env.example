# Plantilla de variables de entorno. Cópiala como `.env` (en esta misma carpeta) y rellena TUS valores.
#   PowerShell:  Copy-Item .env.example .env
# `backend/.env` está en .gitignore: NO se sube a git. Este archivo (.env.example) sí se sube, por eso solo lleva
# marcadores de posición. NUNCA pegues valores reales en el chat, en la documentación, en capturas ni en commits.

# Desarrollo local: 1. En Render NO se define (por defecto es apagado); con DEBUG=1 no hace falta SECRET_KEY.
DEBUG=1

# Solo hace falta si DEBUG no es 1. Para generar una: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Neon: panel del proyecto -> Connect -> cadena de conexión DIRECTA (no la "pooled"), con la contraseña visible.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST_DE_NEON/NOMBRE_DE_BASE?sslmode=require

# Cloudinary: Console -> Settings -> API Keys -> "API environment variable" (cloudinary://clave:secreto@nube).
CLOUDINARY_URL=cloudinary://CLAVE_API:SECRETO_API@NOMBRE_DE_NUBE

# Token para GET /health/servicios (cabecera X-Health-Token). Debe ser IGUAL al que pongas en el panel de Render.
# Para generar uno: python -c "import secrets; print(secrets.token_urlsafe(32))"
HEALTH_TOKEN=

# Hosts extra permitidos, separados por comas (en Render el propio host se añade solo). Normalmente vacío.
ALLOWED_HOSTS=
