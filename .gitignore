local.properties

# Modulo 3 (ML): lo que se genera al entrenar NO se versiona.
# - dataset/: fotos (peso y privacidad; solo deben vivir en Drive del equipo)
# - salida/: modelos y graficas intermedias (el .tflite definitivo se versiona en app/src/main/assets)
/ml/**/dataset/
/ml/**/salida/
/ml/**/wanchaq_limpio_ml/
__pycache__/
*.pyc
/ml/**/dataset_fuera_de_clase/
# Carpeta de paso donde se dejan los archivos bajados de Colab (el modelo definitivo va a app/src/main/assets)
/ml/salida_colab/
# Fotos de calle para probar el modelo (pueden traer rostros o placas): NUNCA a git
/ml/prueba_calle/

# Backend (Django): secretos y artefactos locales. `backend/.env` guarda contrasenas y claves: NUNCA a git.
# Se ignora `.env` en cualquier carpeta; `.env.example` (solo marcadores de posicion) SI se versiona.
.env
.env.*
!.env.example
/backend/.venv/
/backend/venv/
/backend/db.sqlite3
*.sqlite3

# Herramienta de pruebas de la app (herramientas/servidor_falso.py): las fotos que recibio y el modo elegido NO se versionan.
/herramientas/recibidas/
/herramientas/modo.txt

# Llaves de firma del APK (SECRETAS: se guardan fuera del repositorio) y los APK que se reparten al equipo.
*.jks
*.keystore
/distribucion/
